# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME="DineIQ Analytics API"
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_USER=dineiq_user
POSTGRES_PASSWORD=dineiq_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dineiq_analytics
DATABASE_URL=postgresql+psycopg2://dineiq_user:dineiq_password@localhost:5432/dineiq_analytics
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Security and RBAC Configuration
SECRET_KEY=change-this-in-production-super-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@dineiq.local
DEFAULT_ADMIN_PASSWORD=change-admin-password-in-production

# Business and Analytics Defaults
DEFAULT_CURRENCY=USD

# Data Storage Directories
DATA_DIR=data
SNAPSHOTS_DIR=data/snapshots
MARTS_DIR=data/marts
ARTIFACTS_DIR=data/artifacts
